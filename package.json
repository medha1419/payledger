{
  "name": "payledger",
  "version": "1.0.0",
  "description": "A payments ledger REST API with double-entry bookkeeping, idempotent transfers and concurrency-safe balances.",
  "main": "src/server.js",
  "scripts": {
    "migrate": "node src/migrate.js",
    "start": "node src/migrate.js && node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "pg": "^8.23.1"
  }
}
